// Cloudflare Worker 배포 설정 (Workers Builds 가 git push 때마다 이 파일로 배포한다).
// - 화면 파일: public/ (정적 파일)
// - /api/** : server/worker.js 가 functions/ 처리기로 안내
// - D1: c-master-db (database_id 는 이름표일 뿐 비밀값이 아니라 저장소에 둬도 된다)
// 비밀값(AI_HINT_API_KEY, JUDGE0_TOKEN)은 여기 넣지 말고 대시보드의 Variables and Secrets 에 Secret 으로 넣는다.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "app-c-master",
    "main": "server/worker.js",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        // /api 만 Worker 코드를 먼저 거치고, 나머지는 정적 파일을 바로 보낸다 (빠르고 공짜)
        "run_worker_first": ["/api/*"]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "c-master-db",
            "database_id": "199efec6-cfe4-4245-93dd-59ae9ceb9eb8",
            "migrations_dir": "migrations"
        }
    ],
    // 대시보드에서 넣은 변수(TEACHER_USERNAMES 등)를 배포할 때 지우지 않는다
    "keep_vars": true,
    "observability": { "enabled": true }
}
